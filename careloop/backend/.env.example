# CareLoop Production Environment Configuration
PORT=4000
NODE_ENV=production
JWT_SECRET=replace-this-with-a-64-character-cryptographic-random-string
JWT_EXPIRES_IN=7d
OTP_EXPIRES_MINUTES=10

# AWS Credentials & Infrastructure
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_SES_SENDER_EMAIL=support@careloop.health
AWS_COGNITO_USER_POOL_ID=us-east-1_exampleId
AWS_COGNITO_CLIENT_ID=exampleClientId
AWS_S3_BUCKET_NAME=careloop-patient-assets

# CORS Configuration
CORS_ORIGIN=http://localhost:4000,https://careloop.health
